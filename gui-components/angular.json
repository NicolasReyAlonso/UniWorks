{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bcs-gui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "sass"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "allowedCommonJsDependencies": [
              "pbf"
            ],
            "outputPath": {
              "base": "dist/bcs-gui"
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest",
              {
                "glob": "**/*",
                "input": "node_modules/ngx-auth-firebaseui/assets/",
                "output": "./assets/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@ant-design/icons-angular/src/inline-svg/",
                "output": "./assets/"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "node_modules/ol/ol.css",
              "node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
              "node_modules/font-awesome/css/font-awesome.min.css",
              "node_modules/ag-grid-community/styles/ag-grid.css",
              "node_modules/ag-grid-community/styles/ag-theme-alpine.css",
              "src/styles.sass",
              {
                "input": "src/themes/gold.less",
                "bundleName": "themeGold",
                "inject": false
              },
              {
                "input": "src/themes/grassGreen.less",
                "bundleName": "themeGrassGreen",
                "inject": false
              },
              {
                "input": "src/themes/cyan.less",
                "bundleName": "themeCyan",
                "inject": false
              },
              {
                "input": "src/themes/cyan2.less",
                "bundleName": "themeCyan2",
                "inject": false
              },
              {
                "input": "src/themes/gray.less",
                "bundleName": "themeGray",
                "inject": false
              },
              {
                "input": "src/themes/greenNextgendem.less",
                "bundleName": "themeGreenNextgendem",
                "inject": false
              },
              {
                "input": "src/themes/blueNextgendem.less",
                "bundleName": "themeBlueNextgendem",
                "inject": false
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/themes"
              ]
            },
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/jQuery-QueryBuilder/dist/js/query-builder.standalone.js",
              "node_modules/jQuery-QueryBuilder/dist/js/query-builder.js"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "release": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.gh.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "100kb",
                  "maximumError": "150kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "100kb",
                  "maximumError": "150kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "bcs-gui:build"
          },
          "configurations": {
            "release": {
              "buildTarget": "bcs-gui:build:release"
            },
            "production": {
              "buildTarget": "bcs-gui:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "bcs-gui:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
              "node_modules/font-awesome/css/font-awesome.min.css",
              "node_modules/ag-grid-community/styles/ag-grid.css",
              "node_modules/ag-grid-community/styles/ag-theme-alpine.css",
              "src/styles.sass"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/jQuery-QueryBuilder/dist/js/query-builder.standalone.js",
              "node_modules/jQuery-QueryBuilder/dist/js/query-builder.js"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json",
              "tsconfig.spec.json",
              "e2e/tsconfig.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "bcs-gui:serve"
          },
          "configurations": {
            "release": {
              "devServerTarget": "bcs-gui:serve:release"
            },
            "production": {
              "devServerTarget": "bcs-gui:serve:production"
            }
          }
        }
      }
    },
    "ngt-gui": {
      "projectType": "library",
      "root": "projects/ngt-gui",
      "sourceRoot": "projects/ngt-gui/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngt-gui/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngt-gui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngt-gui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ngt-gui/src/test.ts",
            "tsConfig": "projects/ngt-gui/tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
